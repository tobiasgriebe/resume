% pandoc LaTeX template for Dr. Tobias Griebe's CV
% Use with: pandoc --template=templates/cv.latex --pdf-engine=pdflatex
\documentclass[10pt,a4paper]{article}

\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
$if(babel-lang)$
\usepackage[$babel-lang$]{babel}
$else$
\usepackage[ngerman]{babel}
$endif$

\usepackage{a4wide}
\usepackage[
  colorlinks=true,
  urlcolor=blue,
  breaklinks=true,
  bookmarksopen=true,
  bookmarksdepth=4
]{hyperref}
\usepackage{lastpage}
\usepackage{graphicx}
\usepackage{fancyhdr}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{parskip}
\usepackage{enumitem}
\usepackage{microtype}

% Page layout
\addtolength{\voffset}{-30pt}
\addtolength{\textheight}{60pt}
\linespread{1.2}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}

% Header/footer
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[OR]{\thepage\ / \pageref*{LastPage}}

% No section numbering
\setcounter{secnumdepth}{0}

% Section and subsection styling
\makeatletter
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-2ex \@plus -1ex \@minus -.2ex}%
  {0.5ex \@plus .2ex}%
  {\normalfont\Large\bfseries}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-1.5ex \@plus -0.5ex \@minus -.2ex}%
  {0.3ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries}}
\makeatother

% Definition list: date label left-aligned, body indented to 4.5cm
\setlist[description]{
  style=sameline,
  leftmargin=4.5cm,
  labelwidth=3.8cm,
  labelsep=0.2cm,
  align=left,
  font=\normalfont,
  itemsep=8pt,
  parsep=2pt,
}

% Compact bullet lists
\setlist[itemize]{
  leftmargin=*,
  topsep=2pt,
  itemsep=1pt,
  parsep=0pt
}

% Required by pandoc for tight lists
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\begin{document}

\noindent
\begin{minipage}[t]{\dimexpr\textwidth-5.5cm\relax}
\section*{$title$}
\end{minipage}%
$if(photo)$
\hfill
\begin{minipage}[t]{5cm}
\vspace{0pt}
\includegraphics[width=5cm]{$photo$}
\end{minipage}
$endif$
\par\vspace{4pt}

$body$

\end{document}
